---
import HeaderLink from './HeaderLink.astro';
import Wordmark from './Wordmark.astro';
import ThemeToggle from './ThemeToggle.astro';
import { LINKS } from '../consts';
---

<header>
	<nav aria-label="Main">
		<a class="brand" href="/" aria-label="Custom PC Republic blog home">
			<Wordmark size={38} />
		</a>
		<div class="internal-links">
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/shop">Shop</HeaderLink>
			<HeaderLink href="/services">Services</HeaderLink>
			<HeaderLink href="/community">Community</HeaderLink>
			<HeaderLink href="/watch">Watch</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</div>
		<div class="actions">
			<a class="builder" href={LINKS.builder} target="_blank" rel="noopener">Builder ↗</a>
			<ThemeToggle />
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		padding: 0 1rem;
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}
	header::before {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		height: 2px;
		background: linear-gradient(90deg, var(--primary-strong), var(--blue));
		opacity: 0.8;
	}
	nav {
		max-width: var(--max);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 66px;
	}
	.brand {
		text-decoration: none;
		flex: none;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		flex-wrap: wrap;
	}
	.internal-links :global(a) {
		padding: 0.35em 0.75em;
		border-radius: 999px;
		color: var(--muted);
		font-size: 0.93rem;
		font-weight: 500;
		text-decoration: none;
	}
	.internal-links :global(a:hover) {
		color: var(--fg);
		background: var(--elevated);
	}
	.internal-links :global(a.active) {
		color: var(--fg);
		background: var(--elevated);
		box-shadow: inset 0 0 0 1px var(--border);
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex: none;
	}
	.builder {
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--primary);
	}
	@media (max-width: 1020px) {
		.builder {
			display: none;
		}
	}
	@media (max-width: 860px) {
		nav {
			flex-wrap: wrap;
			padding: 0.6rem 0;
			gap: 0.5rem;
		}
		.internal-links {
			order: 3;
			width: 100%;
			overflow-x: auto;
			flex-wrap: nowrap;
			padding-bottom: 0.2rem;
		}
		.internal-links :global(a) {
			white-space: nowrap;
			font-size: 0.9rem;
		}
	}
</style>
