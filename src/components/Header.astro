---
import HeaderLink from './HeaderLink.astro';
import Wordmark from './Wordmark.astro';
import SocialIcons from './SocialIcons.astro';
import { LINKS } from '../consts';
---

<header>
	<nav>
		<a class="brand" href="/" aria-label="Custom PC Republic blog home">
			<Wordmark size={40} />
			<span class="chip">Blog</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/zamesh">Zamesh</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a class="shop" href={LINKS.shop} target="_blank" rel="noopener">Shop ↗</a>
		</div>
		<div class="social-links">
			<SocialIcons />
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0 1rem;
		background: rgba(4, 7, 15, 0.8);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
		box-shadow: 0 1px 0 rgba(46, 118, 248, 0.15);
	}
	header::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 1px;
		background: var(--spectrum);
		opacity: 0.55;
	}
	nav {
		max-width: var(--max);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 64px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		text-decoration: none;
		color: var(--fg);
	}
	.chip {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--carbon);
		background: var(--volt);
		padding: 0.15em 0.5em;
		clip-path: polygon(4px 0, 100% 0, 100% calc(100% - 4px), calc(100% - 4px) 100%, 0 100%, 0 4px);
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		flex-wrap: wrap;
	}
	.internal-links :global(a) {
		padding: 0.4em 0.8em;
		border-radius: var(--radius-sm);
		font-family: var(--font-display);
		letter-spacing: 0.02em;
		color: var(--muted);
		font-size: 0.95rem;
		font-weight: 500;
		text-decoration: none;
	}
	.internal-links :global(a:hover) {
		color: var(--fg);
		background: var(--elevated);
	}
	.internal-links :global(a.active) {
		color: #fff;
		background: var(--elevated);
		box-shadow: inset 0 -2px 0 var(--volt);
		text-decoration: none;
	}
	.internal-links .shop {
		color: var(--volt);
	}
	.social-links {
		display: flex;
		gap: 0.75rem;
	}
	.social-links :global(a) {
		display: flex;
		color: var(--muted);
	}
	.social-links :global(a:hover) {
		color: var(--fg);
	}
	@media (max-width: 860px) {
		.social-links,
		.chip {
			display: none;
		}
	}
	@media (max-width: 600px) {
		nav {
			flex-direction: column;
			align-items: flex-start;
			padding: 0.6rem 0;
			gap: 0.4rem;
		}
		.internal-links :global(a) {
			padding: 0.3em 0.6em;
			font-size: 0.9rem;
		}
	}
</style>
