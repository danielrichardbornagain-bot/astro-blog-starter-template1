---
import HeaderLink from './HeaderLink.astro';
import Logo from './Logo.astro';
import SocialIcons from './SocialIcons.astro';
import { BRAND, LINKS } from '../consts';
---

<header>
	<nav>
		<a class="brand" href="/">
			<Logo size={34} />
			<span class="brand-text">
				<span class="brand-name">{BRAND.name}</span>
				<span class="brand-sub">Blog · {BRAND.subtitle}</span>
			</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/zamesh">Zamesh</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a class="shop" href={LINKS.shop} target="_blank" rel="noopener">Shop ↗</a>
		</div>
		<div class="social-links">
			<SocialIcons />
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0 1rem;
		background: rgba(7, 6, 14, 0.78);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		max-width: var(--max);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 64px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		text-decoration: none;
		color: var(--fg);
	}
	.brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1.1;
	}
	.brand-name {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1rem;
	}
	.brand-sub {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		flex-wrap: wrap;
	}
	.internal-links :global(a) {
		padding: 0.4em 0.8em;
		border-radius: 999px;
		color: var(--muted);
		font-size: 0.95rem;
		font-weight: 500;
		text-decoration: none;
	}
	.internal-links :global(a:hover) {
		color: var(--fg);
		background: var(--elevated);
	}
	.internal-links :global(a.active) {
		color: #fff;
		background: var(--elevated);
		box-shadow: inset 0 0 0 1px var(--primary);
		text-decoration: none;
	}
	.internal-links .shop {
		color: var(--blue);
	}
	.social-links {
		display: flex;
		gap: 0.75rem;
	}
	.social-links :global(a) {
		display: flex;
		color: var(--muted);
	}
	.social-links :global(a:hover) {
		color: var(--fg);
	}
	@media (max-width: 860px) {
		.social-links,
		.brand-sub {
			display: none;
		}
	}
	@media (max-width: 600px) {
		nav {
			flex-direction: column;
			align-items: flex-start;
			padding: 0.6rem 0;
			gap: 0.4rem;
		}
		.internal-links :global(a) {
			padding: 0.3em 0.6em;
			font-size: 0.9rem;
		}
	}
</style>
