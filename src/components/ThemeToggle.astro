---
// Light / dark switch. The initial theme is set by the inline script in BaseHead
// (saved choice → OS preference) so there is no flash on load.
---

<button class="theme-toggle" type="button" aria-label="Switch to light mode" title="Toggle light / dark">
	<svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
		><circle cx="12" cy="12" r="4.2" fill="currentColor"></circle><g stroke="currentColor" stroke-width="2" stroke-linecap="round"
			><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path></g
		></svg
	>
	<svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
		><path fill="currentColor" d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z"></path></svg
	>
	<span class="label">Theme</span>
</button>

<script>
	const KEY = 'cpr-theme';
	function current() {
		return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
	}
	function sync() {
		const t = current();
		document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((b) => {
			b.setAttribute('aria-label', t === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
			b.setAttribute('aria-pressed', String(t === 'light'));
		});
		document.querySelector('meta[name="theme-color"]')?.setAttribute('content', t === 'dark' ? '#07060e' : '#f7f6fb');
	}
	document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((b) =>
		b.addEventListener('click', () => {
			const next = current() === 'dark' ? 'light' : 'dark';
			document.documentElement.dataset.theme = next;
			try {
				localStorage.setItem(KEY, next);
			} catch {}
			sync();
		}),
	);
	sync();
</script>

<style>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		height: 38px;
		padding: 0 0.7rem;
		border-radius: var(--radius-md);
		border: 1px solid var(--border);
		background: var(--panel);
		color: var(--fg);
		font: 500 0.85rem var(--font-sans);
		cursor: pointer;
	}
	.theme-toggle:hover {
		border-color: var(--primary);
	}
	.label {
		display: none;
	}
	:global(:root[data-theme='light']) .sun,
	:global(:root:not([data-theme='light'])) .moon {
		display: none;
	}
</style>
