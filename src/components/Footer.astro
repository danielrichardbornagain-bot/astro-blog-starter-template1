---
import Wordmark from './Wordmark.astro';
import SocialIcons from './SocialIcons.astro';
import { BRAND, CONTACT, LINKS, ZAMESH } from '../consts';
const today = new Date();
---

<footer>
	<div class="inner">
		<div class="col brand">
			<Wordmark size={44} />
			<p>{BRAND.blurb}</p>
			<div class="social-links"><SocialIcons /></div>
		</div>
		<div class="col">
			<span class="eyebrow">Subdomains</span>
			<a href={LINKS.main}>www.custompcrepublic.com</a>
			<a href={LINKS.shop}>shop.custompcrepublic.com</a>
			<a href={LINKS.builder}>builder.custompcrepublic.com</a>
			<a href={LINKS.cloud}>cloud.custompcrepublic.com</a>
			<a href={LINKS.lab}>lab.custompcrepublic.com</a>
			<a href={LINKS.forum}>forum.custompcrepublic.com</a>
		</div>
		<div class="col">
			<span class="eyebrow">This site</span>
			<a href="/blog">Blog</a>
			<a href="/shop">Shop</a>
			<a href="/services">Services</a>
			<a href="/zamesh">Zamesh project</a>
			<a href="/brand">Brand guidelines</a>
		</div>
		<div class="col">
			<span class="eyebrow">Elsewhere</span>
			<a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
			<a href={LINKS.youtube}>YouTube</a>
			<a href={ZAMESH.repo}>GitHub</a>
			<a href={LINKS.forestOfPines}>Forest of Pines</a>
			<a href={LINKS.links}>Full link tree</a>
		</div>
	</div>
	<div class="legal">
		&copy; {today.getFullYear()} {BRAND.name} · Johannesburg · Cloudflare-ready delivery
	</div>
</footer>
<style>
	footer {
		margin-top: 4rem;
		padding: 3rem 1rem 2rem;
		border-top: 1px solid var(--border);
		background: var(--surface);
		color: var(--muted);
		font-size: 0.95rem;
	}
	.inner {
		max-width: var(--max);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1.6fr 1.2fr 0.9fr 1.1fr;
		gap: 2rem;
	}
	.col {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		min-width: 0;
	}
	.col a {
		color: var(--muted);
		text-decoration: none;
		overflow-wrap: anywhere;
	}
	.col a:hover {
		color: var(--fg);
	}
	.brand p {
		margin: 0.75rem 0;
		max-width: 34ch;
	}
	.social-links {
		display: flex;
		gap: 0.9rem;
	}
	.social-links :global(a) {
		color: var(--muted);
		display: flex;
	}
	.legal {
		max-width: var(--max);
		margin: 2.5rem auto 0;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border);
		font-size: 0.85rem;
		color: var(--faint);
		text-align: center;
	}
	@media (max-width: 860px) {
		.inner {
			grid-template-columns: 1fr 1fr;
		}
		.brand {
			grid-column: 1 / -1;
		}
	}
</style>
