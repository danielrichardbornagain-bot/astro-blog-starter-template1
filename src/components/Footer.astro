---
import Wordmark from './Wordmark.astro';
import SocialIcons from './SocialIcons.astro';
import { BRAND, LINKS, ZAMESH } from '../consts';
const today = new Date();
---

<footer>
	<div class="inner">
		<div class="col brand">
			<Wordmark size={52} tagline />
			<p class="muted">{BRAND.location}</p>
			<div class="social-links"><SocialIcons /></div>
		</div>
		<div class="col">
			<span class="eyebrow">Republic</span>
			<a href={LINKS.main}>Main site</a>
			<a href={LINKS.shop}>Shop</a>
			<a href={LINKS.builder}>PC Builder</a>
			<a href={LINKS.lab}>Lab</a>
		</div>
		<div class="col">
			<span class="eyebrow">Community</span>
			<a href={LINKS.forum}>Forum</a>
			<a href={LINKS.lobby}>Lobby</a>
			<a href={LINKS.youtube}>YouTube</a>
			<a href={LINKS.links}>All links</a>
		</div>
		<div class="col">
			<span class="eyebrow">Open source</span>
			<a href="/zamesh">Zamesh project</a>
			<a href={ZAMESH.repo}>Zamesh on GitHub</a>
			<a href={ZAMESH.contributing}>Contributing guide</a>
			<a href="/brand">Brand guidelines</a>
		</div>
	</div>
	<div class="legal">
		&copy; {today.getFullYear()} {BRAND.name}. All rights reserved.
	</div>
</footer>
<style>
	footer {
		margin-top: 4rem;
		padding: 3rem 1rem 2rem;
		border-top: 1px solid var(--border);
		background:
			url('/brand/moodboard/joburg-tower.jpg') right bottom / auto 100% no-repeat,
			linear-gradient(180deg, var(--surface), var(--midnight));
		position: relative;
		color: var(--muted);
		font-size: 0.95rem;
	}
	footer::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, var(--surface) 60%, rgba(10, 16, 32, 0.88));
		pointer-events: none;
	}
	.inner,
	.legal {
		position: relative;
	}
	.inner {
		max-width: var(--max);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 2fr 1fr 1fr 1fr;
		gap: 2rem;
	}
	.col {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.col a {
		color: var(--muted);
		text-decoration: none;
	}
	.col a:hover {
		color: var(--fg);
	}
	.muted {
		margin: 0.5rem 0;
	}
	.social-links {
		display: flex;
		gap: 0.9rem;
	}
	.legal {
		max-width: var(--max);
		margin: 2.5rem auto 0;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border);
		font-size: 0.85rem;
		color: var(--faint);
	}
	@media (max-width: 720px) {
		.inner {
			grid-template-columns: 1fr 1fr;
		}
		.brand {
			grid-column: 1 / -1;
		}
	}
</style>
