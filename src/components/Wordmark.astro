---
import Logo from './Logo.astro';

interface Props {
	size?: number; // shield size in px
	onDark?: boolean;
}
const { size = 44, onDark = false } = Astro.props;
---

<span class="lockup" style={`--m:${size}px`}>
	<Logo size={size} />
	<span class:list={['steel', 'name', { 'on-dark': onDark }]}>Custom PC Republic</span>
</span>

<style>
	.lockup {
		display: inline-flex;
		align-items: center;
		gap: calc(var(--m) * 0.28);
	}
	.name {
		font-size: calc(var(--m) * 0.5);
		line-height: 1;
		white-space: nowrap;
		padding-right: 0.15em; /* room for the italic overhang */
	}
</style>
