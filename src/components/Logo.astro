---
// Shield mark. Full circuit shield at 56px and up; the simplified
// 3-node shield below that (it stays legible down to 16px).
interface Props {
	size?: number;
	variant?: 'auto' | 'full' | 'simple';
}
const { size = 32, variant = 'auto' } = Astro.props;
const full = variant === 'full' || (variant === 'auto' && size >= 56);
---

<img
	src={full ? '/brand/cpr-mark.svg' : '/favicon.svg'}
	width={size}
	height={size}
	alt=""
	aria-hidden="true"
	style="border-radius:0;display:block;flex:none"
/>
