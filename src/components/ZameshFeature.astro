---
import { ZAMESH } from '../consts';

interface Props {
	compact?: boolean;
}
const { compact = false } = Astro.props;
---

<section class:list={['zamesh', { compact }]} aria-labelledby="zamesh-heading">
	<div class="glow" aria-hidden="true"></div>
	<div class="content">
		<span class="eyebrow">// Featured open-source project</span>
		<h2 id="zamesh-heading">
			<span class="gradient-text">Zamesh</span> — contribute with us
		</h2>
		<p class="lead">
			<strong>Zamesh</strong> is the Republic's working fork of Cloudflare's
			<strong>Workers templates</strong>: <mark>36 full-stack starters</mark> we test, harden and adapt for real
			customer stacks — the same code this blog runs on.
		</p>
		<ul class="points">
			<li><span class="dot violet"></span><strong>Fix a template</strong> — bugs, deps, docs</li>
			<li><span class="dot blue"></span><strong>Add a template</strong> — D1, AI, Queues, Durable Objects</li>
			<li><span class="dot green"></span><strong>Harden it</strong> — Zero Trust &amp; security defaults</li>
		</ul>
		<div class="actions">
			<a class="btn btn-primary" href={ZAMESH.repo} target="_blank" rel="noopener">View on GitHub ↗</a>
			{!compact && <a class="btn" href={ZAMESH.contributing} target="_blank" rel="noopener">Contributing guide</a>}
			<a class="btn" href="/zamesh">How to contribute →</a>
		</div>
	</div>
	<pre class="terminal" aria-label="Quick start commands"><code><span class="c"># fork + clone</span>
<span class="p">$</span> git clone {ZAMESH.repo}.git
<span class="p">$</span> cd zamesh && pnpm install

<span class="c"># pick a template, hack, check</span>
<span class="p">$</span> cd astro-blog-starter-template
<span class="p">$</span> pnpm run check
<span class="ok">✔ ready for a pull request</span></code></pre>
</section>
<style>
	.zamesh {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		gap: 2rem;
		align-items: center;
		padding: 2.5rem;
		margin: 3rem 0;
		border-radius: 28px;
		border: 1px solid var(--border);
		background: linear-gradient(135deg, var(--panel), var(--bg));
		overflow: hidden;
	}
	.glow {
		position: absolute;
		inset: -40% -10% auto auto;
		width: 520px;
		height: 520px;
		background: radial-gradient(circle, rgba(74, 222, 128, 0.18), transparent 60%);
		pointer-events: none;
	}
	.content {
		position: relative;
	}
	h2 {
		font-size: 2.2rem;
	}
	.lead {
		color: #d6d3e6;
	}
	mark {
		background: rgba(124, 108, 255, 0.22);
		color: #fff;
		padding: 0 0.3em;
		border-radius: 4px;
		font-weight: 600;
	}
	.points {
		list-style: none;
		padding: 0;
		margin: 0 0 1.5rem;
		display: grid;
		gap: 0.6rem;
	}
	.points li {
		color: var(--muted);
	}
	.dot {
		display: inline-block;
		margin-right: 0.6rem;
		vertical-align: middle;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		flex: none;
	}
	.violet { background: var(--primary); }
	.blue { background: var(--blue); }
	.green { background: var(--ok); }
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.terminal {
		position: relative;
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.7;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		box-shadow: var(--glow);
	}
	.terminal .c { color: var(--faint); }
	.terminal .p { color: var(--primary); }
	.terminal .ok { color: var(--ok); }
	.compact .terminal {
		display: none;
	}
	.compact {
		grid-template-columns: 1fr;
	}
	@media (max-width: 860px) {
		.zamesh {
			grid-template-columns: minmax(0, 1fr);
			padding: 1.5rem;
		}
		h2 {
			font-size: 1.7rem;
		}
	}
</style>
