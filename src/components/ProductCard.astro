---
import type { Product } from '../consts';
import { LINKS } from '../consts';

interface Props {
	product: Product;
}
const { product: p } = Astro.props;
---

<a class="product" href={LINKS.shop} target="_blank" rel="noopener" data-category={p.category}>
	<div class="media">
		{p.image ? <img src={p.image} alt={p.name} loading="lazy" width="900" height="600" /> : <span class="ph" aria-hidden="true">{p.kind}</span>}
	</div>
	<div class="body">
		<span class="kind">{p.kind}</span>
		<h3>{p.name}</h3>
		<p>{p.blurb}</p>
		<span class="price">{p.price}</span>
	</div>
</a>

<style>
	.product {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: var(--fg);
		background: var(--panel);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow);
		transition: transform 0.15s ease, border-color 0.15s ease;
	}
	.product:hover {
		color: var(--fg);
		transform: translateY(-2px);
		border-color: var(--primary);
	}
	.media {
		aspect-ratio: 16 / 10;
		background: #0b0a14;
		display: grid;
		place-items: center;
		overflow: hidden;
	}
	.media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
	}
	.ph {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.4rem;
		color: #8f82ff;
		opacity: 0.7;
	}
	.body {
		padding: 1rem 1.15rem 1.2rem;
		display: flex;
		flex-direction: column;
		flex: 1;
	}
	.kind {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--faint);
	}
	h3 {
		font-size: 1.15rem;
		margin: 0.3rem 0 0.35rem;
	}
	p {
		color: var(--muted);
		font-size: 0.93rem;
		line-height: 1.55;
		margin: 0 0 0.75rem;
		flex: 1;
	}
</style>
