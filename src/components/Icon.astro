---
// Small stroke icons used across the site (24×24).
interface Props {
	name: 'check' | 'share' | 'gear' | 'globe' | 'briefcase' | 'laptop' | 'people' | 'chart' | 'shield' | 'bolt' | 'mail' | 'lock';
	size?: number;
}
const { name, size = 24 } = Astro.props;
const paths: Record<string, string> = {
	check: '<path d="M5 12.5l4.2 4.2L19 7"/>',
	share: '<circle cx="6" cy="12" r="2.6"/><circle cx="18" cy="6" r="2.6"/><circle cx="18" cy="18" r="2.6"/><path d="M8.3 10.8l7.4-3.6M8.3 13.2l7.4 3.6"/>',
	gear: '<circle cx="12" cy="12" r="3.2"/><path d="M12 2.8v2.4M12 18.8v2.4M2.8 12h2.4M18.8 12h2.4M5.5 5.5l1.7 1.7M16.8 16.8l1.7 1.7M5.5 18.5l1.7-1.7M16.8 7.2l1.7-1.7"/>',
	globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.6 3.9 5.6 3.9 9s-1.3 6.4-3.9 9c-2.6-2.6-3.9-5.6-3.9-9S9.4 5.6 12 3z"/>',
	briefcase: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8.5 7V5.2A1.7 1.7 0 0 1 10.2 3.5h3.6a1.7 1.7 0 0 1 1.7 1.7V7M3 12.5h18"/>',
	laptop: '<rect x="4.5" y="5" width="15" height="10.5" rx="1.5"/><path d="M2.5 19h19"/>',
	people: '<circle cx="9" cy="8" r="3.4"/><path d="M2.8 19.5c.6-3.5 3.1-5.5 6.2-5.5s5.6 2 6.2 5.5"/><circle cx="17" cy="9.5" r="2.6"/><path d="M16 14.2c2.6 0 4.6 1.7 5.2 4.6"/>',
	chart: '<path d="M4 20h16M6.5 17v-4M11 17v-7M15.5 17v-5M20 17V8"/><path d="M5 10.5l5-4.5 4 3 6-5.5"/>',
	shield: '<path d="M12 3l8 3v6c0 4.6-3.3 7.9-8 9-4.7-1.1-8-4.4-8-9V6z"/><path d="M8.8 12.2l2.2 2.2 4.3-4.4"/>',
	bolt: '<path d="M13 2.5L5 13.5h6l-1 8 8-11h-6z"/>',
	mail: '<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3.5 7l8.5 6 8.5-6"/>',
	lock: '<rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.8a4 4 0 0 1 8 0v2.7"/>',
};
---

<svg
	viewBox="0 0 24 24"
	width={size}
	height={size}
	fill="none"
	stroke="currentColor"
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	set:html={paths[name]}
/>
