---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import ProductCard from '../components/ProductCard.astro';
import NetworkList from '../components/NetworkList.astro';
import ZameshFeature from '../components/ZameshFeature.astro';
import Logo from '../components/Logo.astro';
import { SITE_TITLE, SITE_DESCRIPTION, BRAND, LINKS, PRODUCTS } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
const floor = PRODUCTS.filter((p) => p.floor);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				display: grid;
				grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
				gap: 2rem;
				align-items: center;
				padding: 2.5rem 0 1rem;
			}
			.hero h1 {
				font-size: clamp(2.6rem, 6.5vw, 4.4rem);
				line-height: 1.02;
				margin-bottom: 1rem;
			}
			.hero h1 span {
				display: block;
			}
			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 1.5rem;
			}
			.hero-mark {
				display: grid;
				place-items: center;
				filter: drop-shadow(0 18px 50px rgba(124, 108, 255, 0.35));
			}
			.grid4 {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 1rem;
			}
			.grid3 {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1rem;
			}
			.feature h3 {
				font-size: 1.2rem;
				margin: 0.5rem 0 0.35rem;
			}
			.feature p {
				margin: 0;
				color: var(--muted);
				font-size: 0.95rem;
			}
			.icon {
				font-size: 1.3rem;
			}
			.pillars {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: 1rem;
			}
			@media (max-width: 960px) {
				.grid4 {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}
			@media (max-width: 760px) {
				.hero,
				.grid3 {
					grid-template-columns: minmax(0, 1fr);
				}
				.hero-mark {
					display: none;
				}
			}
			@media (max-width: 520px) {
				.grid4 {
					grid-template-columns: minmax(0, 1fr);
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div>
					<span class="eyebrow">blog.custompcrepublic.com</span>
					<h1><span>Plug in.</span><span class="gradient-text">Play secure.</span></h1>
					<p class="lead">
						Custom towers, a 3D builder with live FPS graphs, and <strong>Zero Trust</strong> staging — built in
						Johannesburg for <strong>gamers and operators</strong>. This is the journal: build logs, rack diaries
						and lab notes.
					</p>
					<div class="actions">
						<a class="btn btn-primary" href="/blog">Read the blog →</a>
						<a class="btn" href="/shop">Browse the shop</a>
						<a class="btn" href={LINKS.builder} target="_blank" rel="noopener">Enter the builder ↗</a>
					</div>
					<div class="pillars">{BRAND.pillars.map((p) => <span class="pill">✓ {p}</span>)}</div>
				</div>
				<div class="hero-mark"><Logo size={280} variant="full" /></div>
			</section>

			<div class="section-head">
				<h2>Latest posts</h2>
				<a href="/blog">All posts →</a>
			</div>
			<div class="grid3">{posts.map((post) => <PostCard post={post} />)}</div>

			<div class="section-head">
				<h2>Floor machines</h2>
				<a href="/shop">Full catalogue →</a>
			</div>
			<div class="grid4">{floor.map((p) => <ProductCard product={p} />)}</div>

			<div class="grid3" style="margin-top:1.5rem">
				<div class="card feature">
					<span class="icon">🖥️</span>
					<h3>Custom + capture</h3>
					<p>From the Pulse 1440 to the Lt. Loki stream box. Built, cabled, burned in.</p>
				</div>
				<div class="card feature">
					<span class="icon">🛡️</span>
					<h3>Zero Trust retail</h3>
					<p>Identity, DNS shield, firmware lock. Same stack we run on the homelab rack.</p>
				</div>
				<div class="card feature">
					<span class="icon">🌲</span>
					<h3>Forest of Pines</h3>
					<p>The side hustle: adaptive climbing in Randburg. Art and movement downstairs.</p>
				</div>
			</div>

			<ZameshFeature />

			<div class="section-head">
				<h2>The Republic network</h2>
			</div>
			<p class="lead" style="margin-top:-.5rem">Subdomains and sister sites — cloud studio, lab, forum, lobby, and Forest of Pines.</p>
			<NetworkList />
		</main>
		<Footer />
	</body>
</html>
