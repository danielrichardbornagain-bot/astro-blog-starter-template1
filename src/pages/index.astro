---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import ZameshFeature from '../components/ZameshFeature.astro';
import Logo from '../components/Logo.astro';
import { SITE_TITLE, SITE_DESCRIPTION, BRAND, LINKS } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				display: grid;
				grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
				gap: 2rem;
				align-items: center;
				padding: 3rem 0 2rem;
			}
			.hero-mark {
				display: grid;
				place-items: center;
				filter: drop-shadow(0 0 40px rgba(46, 118, 248, 0.45)) drop-shadow(0 0 80px rgba(123, 60, 244, 0.25));
			}
			@media (max-width: 760px) {
				.hero {
					grid-template-columns: minmax(0, 1fr);
				}
				.hero-mark {
					display: none;
				}
			}
			.hero h1 {
				font-size: clamp(2.6rem, 6.5vw, 4.6rem);
				line-height: 1.02;
			}
			.hero p {
				font-size: 1.2rem;
				color: var(--muted);
				max-width: 640px;
			}
			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 1.5rem;
			}
			.pillars {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				gap: 1rem;
				margin: 2rem 0 1rem;
			}
			.pillars .card h3 {
				font-size: 1.2rem;
				margin-bottom: 0.3rem;
			}
			.pillars .card p {
				margin: 0;
				color: var(--muted);
				font-size: 0.95rem;
			}
			.kicker {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--volt);
			}
			.section-head {
				display: flex;
				justify-content: space-between;
				align-items: end;
				gap: 1rem;
				margin: 3rem 0 1.25rem;
			}
			.section-head h2 {
				font-size: 2rem;
				margin: 0;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
				gap: 1.5rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div>
					<span class="eyebrow">// {BRAND.subtitle}</span>
					<h1>Plug in.<br /><span class="gradient-text">Play secure.</span></h1>
					<span class="spectrum-bar" style="margin:0 0 1.25rem"></span>
					<p>
						The official blog of <strong>{BRAND.name}</strong> — custom gaming rigs, creator workstations,
						<strong>Zero Trust</strong> homelabs and the open-source work behind them.
					</p>
					<div class="actions">
						<a class="btn btn-primary" href="/blog">Read the blog</a>
						<a class="btn" href="/zamesh">Contribute to Zamesh</a>
						<a class="btn" href={LINKS.builder} target="_blank" rel="noopener">Configure a PC ↗</a>
					</div>
				</div>
				<div class="hero-mark"><Logo size={300} variant="full" /></div>
			</section>

			<section class="pillars" aria-label="What we write about">
				<div class="card">
					<span class="kicker">01 · BUILDS</span>
					<h3>Republic rigs</h3>
					<p>Pulse 1440, Lt. Loki War Machine, Republic Cube &amp; Snowline Creator — build logs and benchmarks.</p>
				</div>
				<div class="card">
					<span class="kicker">02 · SECURITY</span>
					<h3>Zero Trust staging</h3>
					<p>Homelab and small-office setups that ship secure by default.</p>
				</div>
				<div class="card">
					<span class="kicker">03 · OPEN SOURCE</span>
					<h3>Zamesh</h3>
					<p>Workers templates we maintain in the open — and you can help.</p>
				</div>
			</section>

			<div class="section-head">
				<h2>Latest posts</h2>
				<a href="/blog">All posts →</a>
			</div>
			<div class="grid">
				{posts.map((post) => <PostCard post={post} />)}
			</div>

			<ZameshFeature />
		</main>
		<Footer />
	</body>
</html>
