---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BrandCard from '../components/BrandCard.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SERVICES, ENGAGEMENTS } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const threats = [
	{ icon: 'bolt', name: 'DDoS attacks', body: 'Floods of fake traffic are absorbed by Cloudflare’s global network before they reach you.' },
	{ icon: 'mail', name: 'Phishing & spoofing', body: 'SPF, DKIM and DMARC stop criminals sending email that pretends to be you.' },
	{ icon: 'lock', name: 'Cross-site scripting', body: 'A web application firewall filters malicious scripts aimed at your site and visitors.' },
	{ icon: 'shield', name: 'Injection attacks', body: 'SQL and code-injection attempts are blocked at the edge, with managed rules kept up to date.' },
] as const;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — Simplify · Integrate · Automate`} description={SITE_DESCRIPTION} />
		<style>
			.grid3 {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1rem;
			}
			.grid4 {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 1rem;
			}
			.svc h3,
			.threat h3 {
				font-size: 1.15rem;
				margin: 0.5rem 0 0.35rem;
			}
			.svc p,
			.threat p {
				margin: 0;
				color: var(--muted);
				font-size: 0.95rem;
			}
			.svc .ic {
				font-size: 1.5rem;
			}
			.threat .ic {
				color: var(--primary);
			}
			.edge {
				margin-top: 1rem;
			}
			.eng .tag {
				float: right;
			}
			.eng h3 {
				font-size: 1.2rem;
			}
			.eng p {
				margin: 0;
				color: var(--muted);
			}
			.cta {
				margin-top: 3.5rem;
				text-align: center;
				padding: 2.5rem 1.5rem;
			}
			.cta p {
				color: var(--muted);
				max-width: 56ch;
				margin: 0 auto 1.25rem;
			}
			@media (max-width: 960px) {
				.grid4 {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}
			@media (max-width: 760px) {
				.grid3,
				.grid4 {
					grid-template-columns: minmax(0, 1fr);
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<BrandCard />

			<div class="section-head">
				<h2>How we help</h2>
				<a href="/services">All services →</a>
			</div>
			<div class="grid3">
				{
					SERVICES.slice(0, 6).map((s) => (
						<div class="card svc">
							<span class="ic">{s.icon}</span>
							<h3>{s.title}</h3>
							<p>{s.body}</p>
						</div>
					))
				}
			</div>

			<div class="section-head">
				<h2>Secure at the edge</h2>
				<a href="/blog/edge-security-ddos-waf/">How it works →</a>
			</div>
			<p class="lead" style="margin-top:-.5rem">
				Every website, blog, SaaS app and internal tool we host runs behind <strong>Cloudflare</strong>, with protection
				switched on from day one.
			</p>
			<div class="grid4 edge">
				{
					threats.map((t) => (
						<div class="card threat">
							<span class="ic"><Icon name={t.icon} size={28} /></span>
							<h3>{t.name}</h3>
							<p>{t.body}</p>
						</div>
					))
				}
			</div>

			<div class="section-head"><h2>Work with us your way</h2></div>
			<div class="grid3">
				{
					ENGAGEMENTS.map((e) => (
						<div class="card eng">
							{e.tag && <span class="pill tag">{e.tag}</span>}
							<h3>{e.name}</h3>
							<p>{e.body}</p>
						</div>
					))
				}
			</div>

			<div class="section-head">
				<h2>From the blog</h2>
				<a href="/blog">All posts →</a>
			</div>
			<div class="grid3">{posts.map((post) => <PostCard post={post} />)}</div>

			<div class="card cta">
				<h2>Let’s simplify your tech</h2>
				<p>Tell us what you need: a quick fix, a cloud roadmap or a managed contract. We’ll reply with next steps.</p>
				<a class="btn btn-primary" href="/contact">Contact us</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
