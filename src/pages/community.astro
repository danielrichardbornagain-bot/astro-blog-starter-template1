---
import Page from '../layouts/Page.astro';
import { BUILDS, LINKS } from '../consts';
---

<Page
	title="Community"
	description="Suggested builds from the shop floor, the Discord and the HLL nights."
	eyebrow="forum.custompcrepublic.com"
	heading="Community forge"
	lead="Suggested specs from the shop floor, the Discord, and the HLL nights. Load any of them into the 3D builder."
>
	<div class="grid">
		{
			BUILDS.map((b) => (
				<div class="card build">
					<div class="top">
						<h3>{b.name}</h3>
						<span class="votes">▲ {b.votes}</span>
					</div>
					<span class="by">by {b.by}</span>
					<p>{b.body}</p>
					<div class="bottom">
						<span class="price">{b.price}</span>
						<a href={LINKS.builder} target="_blank" rel="noopener">Load in builder ↗</a>
					</div>
				</div>
			))
		}
	</div>

	<div class="card join">
		<div>
			<h3>Join the threads</h3>
			<p>GPU price watch, OpenWrt edge nodes, Hell Let Loose settings, gamer IP shields and climbing — it's all on the forum.</p>
		</div>
		<a class="btn btn-primary" href={LINKS.forum} target="_blank" rel="noopener">Open the forum ↗</a>
	</div>
</Page>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}
	.build {
		display: flex;
		flex-direction: column;
	}
	.top {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		align-items: baseline;
	}
	.top h3 {
		font-size: 1.3rem;
		margin: 0;
	}
	.votes {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--primary);
	}
	.by {
		font-size: 0.85rem;
		color: var(--faint);
	}
	.build p {
		color: var(--muted);
		margin: 0.6rem 0 1rem;
		flex: 1;
	}
	.bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.92rem;
	}
	.join {
		margin-top: 1.5rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
	}
	.join h3 {
		font-size: 1.3rem;
	}
	.join p {
		margin: 0;
		color: var(--muted);
		max-width: 60ch;
	}
	@media (max-width: 760px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
