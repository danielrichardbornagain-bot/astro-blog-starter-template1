---
import Page from '../layouts/Page.astro';
import { BRAND } from '../consts';

const topics = [
	['home', 'Help at home (individuals & families)'],
	['business', 'Business IT / managed services'],
	['support', 'Something is broken (break & fix)'],
	['microsoft', 'Microsoft 365 & Azure'],
	['hosting', 'Website, blog or app hosting'],
	['security', 'Security, DNS & email protection'],
	['shop', 'Custom PC from the shop'],
	['other', 'Something else'],
];
---

<Page
	title="Contact us"
	description="Send Custom PC Republic a message about IT support, Microsoft 365, cloud, hosting or security."
	eyebrow="Contact us"
	heading="Tell us what you need."
	lead={BRAND.tagline}
>
	<div class="wrap">
		<form class="card" id="contact" method="post" action="/api/contact" novalidate>
			<div id="status" role="status" aria-live="polite"></div>
			<div class="row">
				<div>
					<label for="name">Your name *</label>
					<input id="name" name="name" autocomplete="name" required maxlength="100" />
				</div>
				<div>
					<label for="email">Email *</label>
					<input id="email" name="email" type="email" autocomplete="email" required maxlength="200" />
				</div>
			</div>
			<div class="row">
				<div>
					<label for="company">Company <span class="opt">(optional)</span></label>
					<input id="company" name="company" autocomplete="organization" maxlength="120" />
				</div>
				<div>
					<label for="topic">Topic *</label>
					<select id="topic" name="topic" required>
						{topics.map(([v, l]) => <option value={v}>{l}</option>)}
					</select>
				</div>
			</div>
			<div>
				<label for="message">How can we help? *</label>
				<textarea id="message" name="message" required maxlength="4000" placeholder="Tell us a little about your setup and what's going on."></textarea>
			</div>
			<div class="hp" aria-hidden="true">
				<label for="website">Leave this empty</label>
				<input id="website" name="website" tabindex="-1" autocomplete="off" />
			</div>
			<button class="btn btn-primary" type="submit">Send message</button>
			<p class="fine">We use your details only to reply to you. No newsletters, no sharing.</p>
		</form>

		<aside class="side">
			<div class="card">
				<h3>What happens next</h3>
				<ol>
					<li>We read every message and reply by email.</li>
					<li>For urgent breakages, tell us in the message, and we’ll prioritise it.</li>
					<li>Businesses: we’ll suggest a quick consultation to scope your needs.</li>
				</ol>
			</div>
			<div class="card">
				<h3>Ways to work with us</h3>
				<p><strong>Managed contract</strong>, <strong>consultation</strong> or <strong>break &amp; fix</strong>. <a href="/services">See services →</a></p>
			</div>
		</aside>
	</div>
</Page>

<script>
	const form = document.getElementById('contact') as HTMLFormElement;
	const status = document.getElementById('status')!;
	const params = new URLSearchParams(location.search);
	const topic = params.get('topic');
	if (topic) (form.elements.namedItem('topic') as HTMLSelectElement).value = topic;
	function show(kind: 'ok' | 'err', text: string) {
		status.className = kind;
		status.textContent = text;
	}
	if (params.get('sent')) show('ok', 'Thanks! Your message has been sent. We’ll reply by email soon.');
	if (params.get('error')) show('err', 'Sorry, something went wrong. Please check the form and try again.');

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}
		const btn = form.querySelector('button')!;
		btn.disabled = true;
		btn.textContent = 'Sending…';
		try {
			const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
			const data = await res.json().catch(() => ({ ok: false }));
			if (res.ok && data.ok) {
				form.reset();
				show('ok', 'Thanks! Your message has been sent. We’ll reply by email soon.');
			} else {
				show('err', data.error ?? 'Sorry, something went wrong. Please try again.');
			}
		} catch {
			show('err', 'Network error. Please check your connection and try again.');
		} finally {
			btn.disabled = false;
			btn.textContent = 'Send message';
		}
	});
</script>

<style>
	.wrap {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
		gap: 1.25rem;
		align-items: start;
	}
	form {
		display: grid;
		gap: 1rem;
	}
	.row {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}
	.opt {
		font-weight: 400;
		color: var(--muted);
	}
	.hp {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}
	button {
		justify-self: start;
		border: 0;
		cursor: pointer;
		font-family: inherit;
	}
	button:disabled {
		opacity: 0.7;
		cursor: progress;
	}
	.fine {
		margin: 0;
		font-size: 0.85rem;
		color: var(--muted);
	}
	#status:empty {
		display: none;
	}
	#status {
		padding: 0.8rem 1rem;
		border-radius: var(--radius-md);
		font-weight: 500;
	}
	#status.ok {
		background: color-mix(in srgb, var(--ok) 15%, transparent);
		border: 1px solid var(--ok);
	}
	#status.err {
		background: color-mix(in srgb, var(--danger) 15%, transparent);
		border: 1px solid var(--danger);
	}
	.side {
		display: grid;
		gap: 1rem;
	}
	.side h3 {
		font-size: 1.15rem;
	}
	.side ol {
		padding-left: 1.2rem;
		margin: 0;
		color: var(--text);
	}
	.side li {
		margin-bottom: 0.4rem;
	}
	.side p {
		margin: 0;
		color: var(--text);
	}
	@media (max-width: 860px) {
		.wrap,
		.row {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
