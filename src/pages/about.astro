---
import Page from '../layouts/Page.astro';
import ZameshFeature from '../components/ZameshFeature.astro';
import Logo from '../components/Logo.astro';
import { BRAND, CONTACT, LINKS, PRODUCTS } from '../consts';

const services = [
	{ k: 'Build', title: 'Custom & prebuilt PCs', body: 'Hand-built towers, laptops and stream boxes — cabled, stress-tested and burned in overnight in Randburg.' },
	{ k: 'Secure', title: 'Zero Trust staging', body: 'Identity, DNS shield and firmware lock for homes, homelabs and branches. Same stack we run on our own rack.' },
	{ k: 'Support', title: 'Managed IT & support', body: 'Tailored IT solutions and emergency tech support with 99% SLA resolution for businesses and individuals.' },
	{ k: 'Deliver', title: 'Cloud & web', body: 'Serverless sites on Cloudflare Pages and Workers, plus DNS hygiene, migrations and automation.' },
];
const lineup = PRODUCTS.filter((p) => p.floor);
---

<Page
	title="About"
	description={`${BRAND.name} — hand-built systems, Zero Trust staging and serverless delivery from ${BRAND.location}.`}
	eyebrow="About the Republic"
	heading="Gamers and operators on the same desk."
>
	<div slot="intro" class="intro">
		<p class="lead">
			<strong>{BRAND.name}</strong> builds custom PCs, stages Zero Trust networks and ships serverless websites from
			<strong>Westdene, Randburg</strong>. We take the tech jargon out of your tech — and improve efficiencies and
			innovations as we do it.
		</p>
	</div>

	<div class="split">
		<div class="card mission">
			<span class="eyebrow">Our mission</span>
			<p>
				Master expertise in <strong class="v">knowing</strong> your technology, <strong class="b">supporting</strong> it,
				then <strong class="v">improving</strong> it — with as much <strong class="b">synergy</strong> as possible for
				your workforce and your <strong class="v">business</strong>.
			</p>
			<div class="pillars">{BRAND.pillars.map((p) => <span class="pill">✓ {p}</span>)}</div>
		</div>
		<div class="card facts">
			<Logo size={84} variant="full" />
			<dl>
				<div><dt>Motto</dt><dd>{BRAND.tagline}</dd></div>
				<div><dt>Energy</dt><dd>{BRAND.subtitle}</dd></div>
				<div><dt>Based in</dt><dd>Westdene, Randburg</dd></div>
				<div><dt>Email</dt><dd><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></dd></div>
			</dl>
		</div>
	</div>

	<div class="section-head"><h2>What we do</h2></div>
	<div class="grid4">
		{
			services.map((s) => (
				<div class="card svc">
					<span class="eyebrow">{s.k}</span>
					<h3>{s.title}</h3>
					<p>{s.body}</p>
				</div>
			))
		}
	</div>

	<div class="section-head">
		<h2>The lineup</h2>
		<a href="/shop">Full catalogue →</a>
	</div>
	<ul class="lineup">
		{lineup.map((l) => <li><strong>{l.name}</strong><span>{l.kind} · <span class="price">{l.price}</span></span></li>)}
	</ul>

	<ZameshFeature />

	<div class="card sister">
		<p><strong>Sister venture:</strong> Forest of Pines — Climbing Tree, adaptive climbing sessions in Randburg led by Daniel Jacobs.</p>
		<a class="btn" href={LINKS.forestOfPines} target="_blank" rel="noopener">forestofpines.com ↗</a>
	</div>
</Page>

<style>
	.split {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
		gap: 1rem;
	}
	.mission p {
		font-size: 1.2rem;
		line-height: 1.6;
		color: var(--text);
	}
	.v { color: var(--primary); }
	.b { color: var(--blue); }
	.pillars {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	.facts {
		display: flex;
		gap: 1.25rem;
		align-items: center;
	}
	dl {
		margin: 0;
		display: grid;
		gap: 0.55rem;
		flex: 1;
		min-width: 0;
	}
	dt {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--faint);
	}
	dd {
		margin: 0;
		font-weight: 600;
		overflow-wrap: anywhere;
	}
	.grid4 {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
	}
	.svc h3 {
		font-size: 1.15rem;
		margin-bottom: 0.35rem;
	}
	.svc p {
		margin: 0;
		color: var(--muted);
		font-size: 0.95rem;
	}
	.lineup {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
	}
	.lineup li {
		padding: 1rem 1.1rem;
		border: 1px dashed var(--border);
		border-radius: var(--radius-md);
		background: var(--surface);
	}
	.lineup strong {
		display: block;
		font-family: var(--font-display);
	}
	.lineup span {
		color: var(--muted);
		font-size: 0.9rem;
	}
	.sister {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.sister p {
		margin: 0;
		color: var(--muted);
	}
	@media (max-width: 960px) {
		.grid4,
		.lineup {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 760px) {
		.split,
		.grid4,
		.lineup {
			grid-template-columns: minmax(0, 1fr);
		}
		.facts {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
