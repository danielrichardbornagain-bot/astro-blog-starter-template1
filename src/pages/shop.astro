---
import Page from '../layouts/Page.astro';
import ProductCard from '../components/ProductCard.astro';
import { PRODUCTS, LINKS } from '../consts';

const cats = ['all', 'systems', 'laptops', 'components', 'network', 'lab'];
---

<Page
	title="Shop"
	description="Prebuilts, laptops, GPUs and the edge kit we actually rack in Westdene."
	eyebrow="shop.custompcrepublic.com"
	heading="Floor and lab"
	lead="Prebuilts, laptops, GPUs, and the edge kit we actually rack in Westdene. Prices in rand — order and check stock on the shop."
>
	<div class="filters" role="group" aria-label="Filter catalogue">
		{cats.map((c, i) => <button type="button" data-filter={c} aria-pressed={i === 0 ? 'true' : 'false'}>{c}</button>)}
	</div>
	<div class="grid" id="catalogue">{PRODUCTS.map((p) => <ProductCard product={p} />)}</div>
	<p class="note">
		Every floor unit is burned in overnight in Randburg. <a href={LINKS.shop} target="_blank" rel="noopener">Order on shop.custompcrepublic.com ↗</a>
		· <a href={LINKS.builder} target="_blank" rel="noopener">Spec your own in the 3D builder ↗</a>
	</p>
</Page>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
	const cards = document.querySelectorAll<HTMLElement>('#catalogue [data-category]');
	buttons.forEach((b) =>
		b.addEventListener('click', () => {
			const f = b.dataset.filter;
			buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
			cards.forEach((c) => (c.style.display = f === 'all' || c.dataset.category === f ? '' : 'none'));
		}),
	);
</script>

<style>
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}
	.filters button {
		font: 500 0.88rem var(--font-sans);
		text-transform: capitalize;
		padding: 0.4em 0.95em;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--panel);
		color: var(--muted);
		cursor: pointer;
	}
	.filters button[aria-pressed='true'] {
		background: var(--primary-strong);
		border-color: transparent;
		color: #fff;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 1rem;
	}
	.note {
		margin-top: 2rem;
		color: var(--muted);
	}
</style>
