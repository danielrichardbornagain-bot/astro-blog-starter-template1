---
import Page from '../layouts/Page.astro';
import Logo from '../components/Logo.astro';
import Wordmark from '../components/Wordmark.astro';
import { BRAND } from '../consts';

const core = [
	{ name: 'Shield Violet', hex: '#7C6CFF', role: 'Glow, highlights, primary buttons (#6A5AF0 for text on fills).', ink: '#FFFFFF' },
	{ name: 'Circuit Blue', hex: '#3BA6FF', role: 'Glow, links, secondary highlights.', ink: '#07060E' },
	{ name: 'Brushed Steel', hex: '#C9CCD6', role: 'Logo rim, chip and the steel wordmark.', ink: '#07060E' },
	{ name: 'Carbon', hex: '#09080F', role: 'Header, footer and brand-card backgrounds.', ink: '#FFFFFF' },
];
const type = [
	{ face: 'Exo 2', role: 'Wordmark (900 italic, steel) & headings (700)', sample: 'CUSTOM PC REPUBLIC', css: 'var(--font-display)', cls: 'steel', size: '2.2rem' },
	{ face: 'Outfit', role: 'Body text & UI (18px, 1.7 line height)', sample: 'Simplify technology with tech experts and 99% SLA resolution.', css: 'var(--font-sans)', cls: '', size: '1.25rem' },
	{ face: 'IBM Plex Mono', role: 'Labels & code', sample: 'SERVICES · BLOG · DNS', css: 'var(--font-mono)', cls: '', size: '1.05rem' },
];
---

<Page
	title="Brand guidelines"
	description="Custom PC Republic brand guidelines: the steel shield logo, colours, type and voice."
	eyebrow="Brand guidelines · v4"
	heading="The steel shield."
	lead="Our identity comes straight from the Custom PC Republic brand card: a steel shield around a chip, a brushed-steel wordmark and a violet-to-blue glow on carbon."
>
	<div slot="intro" class="row">
		<a class="btn btn-primary" href="/brand/cpr-shield.png" download>Download logo (PNG)</a>
		<a class="btn" href="/brand/favicon-192.png" download>Icon 192px</a>
		<a class="btn" href="/images/og-default.jpg" download>Social card</a>
		<a class="btn" href="/images/blog/placeholder.jpg" download>Blog banner placeholder</a>
	</div>

	<section>
		<h2>Logo</h2>
		<div class="logos">
			<div class="tile carbon"><span class="cap">Primary lockup</span><Wordmark size={70} onDark /></div>
			<div class="tile carbon"><span class="cap">Shield with glow</span><Logo size={170} glow /></div>
			<div class="tile light"><span class="cap">On light</span><Logo size={140} /></div>
			<div class="tile carbon">
				<span class="cap">Icon sizes</span>
				<div class="sizes">
					<div><img src="/brand/favicon-96.png" width="96" height="96" alt="" /><span>96</span></div>
					<div><img src="/brand/favicon-48.png" width="48" height="48" alt="" /><span>48</span></div>
					<div><img src="/brand/favicon-32.png" width="32" height="32" alt="" /><span>32</span></div>
					<div><img src="/brand/favicon-16.png" width="16" height="16" alt="" /><span>16</span></div>
				</div>
			</div>
		</div>
		<div class="rules">
			<div class="card"><h3 class="ok">✅ Do</h3><ul>
				<li>Use the shield <strong>exactly as supplied</strong>: steel rim, chip and violet/blue panels.</li>
				<li>Pair it with the <strong>steel "CUSTOM PC REPUBLIC"</strong> wordmark (Exo 2, 900 italic).</li>
				<li>Place it on <strong>carbon</strong> backgrounds. On light pages, keep the header and footer carbon.</li>
			</ul></div>
			<div class="card"><h3 class="no">🚫 Don't</h3><ul>
				<li>Use the old <strong>"Custom PC RSA"</strong> name or logos on new material.</li>
				<li>Redraw, recolour, stretch or crop the shield.</li>
				<li>Put gaming or neon-green artwork alongside the logo.</li>
			</ul></div>
		</div>
	</section>

	<section>
		<h2>Colour</h2>
		<div class="core">
			{
				core.map((c) => (
					<div class="swatch">
						<div class="chip" style={`background:${c.hex};color:${c.ink}`}>{c.name}</div>
						<div class="meta"><b>{c.hex}</b><br />{c.role}</div>
					</div>
				))
			}
		</div>
		<p class="small">The site has light and dark themes. Every text colour meets WCAG AA contrast in both; the tokens are in <code>src/styles/global.css</code>.</p>
	</section>

	<section>
		<h2>Type</h2>
		{
			type.map((t) => (
				<div class="type-row">
					<div class="face">{t.face}<small>{t.role}</small></div>
					<div class:list={['sample', t.cls]} style={`font-family:${t.css};font-size:${t.size}`}>{t.sample}</div>
				</div>
			))
		}
	</section>

	<section>
		<h2>Voice</h2>
		<p class="lead"><em>{BRAND.tagline}</em></p>
		<div class="voice">
			{BRAND.pillars.map((p) => <div class="card"><h3 class="steel">{p.name}</h3><p>{p.body}</p></div>)}
		</div>
		<ul class="tone">
			<li><strong>Plain English first.</strong> We take the tech jargon out of your tech.</li>
			<li><strong>Two audiences.</strong> Friendly and practical for individuals; clear outcomes, risk and cost for business decision-makers.</li>
			<li><strong>Honest promises.</strong> We name the vendors we use, and we don't over-claim on security.</li>
		</ul>
	</section>
</Page>

<style>
	section { margin-top: 3.5rem; }
	h2 { font-size: 1.9rem; }
	.row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1rem; }
	.small { color: var(--muted); font-size: 0.92rem; margin-top: 0.8rem; }
	.logos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
	.tile {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 230px;
		padding: 2rem 1.5rem 1.5rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		overflow: hidden;
	}
	.tile.carbon {
		background:
			radial-gradient(420px 260px at 30% 50%, rgba(124, 108, 255, 0.22), transparent 70%),
			repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.022) 0 2px, transparent 2px 4px),
			#09080f;
	}
	.tile.light { background: #f7f6fb; }
	.cap {
		position: absolute;
		left: 0.9rem;
		top: 0.7rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #8b86a3;
	}
	.light .cap { color: #6a6582; }
	.tile :global(.lockup) { max-width: 100%; }
	.tile :global(.name) { white-space: normal; }
	.sizes { display: flex; gap: 1.5rem; align-items: end; }
	.sizes img { border-radius: 0; }
	.sizes span { display: block; text-align: center; font-family: var(--font-mono); font-size: 0.7rem; color: #8b86a3; margin-top: 0.4rem; }
	.rules { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
	.rules ul, .tone { margin: 0; padding-left: 1.2rem; color: var(--text); }
	.rules li, .tone li { margin-bottom: 0.4rem; }
	.ok { color: var(--ok); font-size: 1.2rem; }
	.no { color: var(--danger); font-size: 1.2rem; }
	.core { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
	.swatch { border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--panel); }
	.chip { height: 110px; display: flex; align-items: end; padding: 1rem; font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; }
	.meta { padding: 0.85rem 1rem 1rem; color: var(--muted); font-size: 0.9rem; }
	.meta b { color: var(--fg); font-family: var(--font-mono); }
	.type-row { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 1.5rem; padding: 1.2rem 0; border-bottom: 1px solid var(--border); align-items: center; }
	.face { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; }
	.face small { display: block; font-family: var(--font-sans); font-weight: 400; color: var(--muted); font-size: 0.85rem; }
	.voice { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin: 1rem 0 1.25rem; }
	.voice h3 { font-size: 1.5rem; margin-bottom: 0.3rem; }
	.voice p { margin: 0; color: var(--muted); }
	@media (max-width: 860px) {
		.logos, .rules, .voice { grid-template-columns: minmax(0, 1fr); }
		.core { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.type-row { grid-template-columns: minmax(0, 1fr); gap: 0.4rem; }
	}
</style>
