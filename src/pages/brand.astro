---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
import Wordmark from '../components/Wordmark.astro';

const core = [
	{ name: 'Volt Green', token: '--volt', hex: '#9BEB2A', rgb: '155 235 42', role: 'Energy. Primary buttons, eyebrows, live states.', ink: '#04070F', aa: '13.7 : 1' },
	{ name: 'Circuit Blue', token: '--circuit', hex: '#2E76F8', rgb: '46 118 248', role: 'Trust. Mark spine, quotes, focus rings.', ink: '#FFFFFF', aa: '4.9 : 1' },
	{ name: 'Shield Violet', token: '--violet', hex: '#7B3CF4', rgb: '123 60 244', role: 'Security. Mark nodes, gradient end, depth.', ink: '#FFFFFF', aa: '3.6 : 1 (large only)' },
];
const neutrals = [
	{ name: 'Carbon', token: '--carbon', hex: '#04070F', role: 'Page background' },
	{ name: "Jo'burg Midnight", token: '--midnight', hex: '#041734', role: 'Atmosphere, footer, banners' },
	{ name: 'Panel', token: '--panel', hex: '#0E1529', role: 'Cards & surfaces' },
	{ name: 'Gunmetal', token: '--gunmetal', hex: '#3A3F48', role: 'Shield plate' },
	{ name: 'Brushed Steel', token: '--steel', hex: '#C5CAD3', role: 'Mark rim, "CUSTOM PC" line' },
	{ name: 'Skyline Blue', token: '--sky', hex: '#A8D4F5', role: 'Taglines' },
	{ name: 'Text', token: '--fg', hex: '#EEF2F8', role: 'Headings & body' },
	{ name: 'Muted', token: '--muted', hex: '#A3AEC2', role: 'Secondary text' },
];
const tints = [
	{ name: 'Violet text', token: '--primary', hex: '#9A6BFF', aa: '5.7 : 1' },
	{ name: 'Blue text / links', token: '--blue', hex: '#5B9BFF', aa: '7.3 : 1' },
];
const type = [
	{ face: 'Orbitron', role: 'Wordmark & rare display', weights: '800–900 · UPPERCASE · +6% tracking', sample: 'CUSTOM PC REPUBLIC', css: 'var(--font-brand)', cls: 'brand-type' },
	{ face: 'Chakra Petch', role: 'Headings, nav, buttons', weights: '600–700', sample: 'Built tough. Shipped secure.', css: 'var(--font-display)' },
	{ face: 'Outfit', role: 'Body copy', weights: '400 · 600 for emphasis', sample: 'Hand-built rigs and Zero Trust homelabs from Westdene, Randburg.', css: 'var(--font-sans)' },
	{ face: 'JetBrains Mono', role: 'Eyebrows, labels, code', weights: '400–500 · UPPERCASE labels +18%', sample: '// LAB NOTES · ZERO TRUST', css: 'var(--font-mono)' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Brand guidelines · Custom PC Republic"
			description="The Custom PC Republic 'Neon Shield' brand system: logo, colour, type, UI and voice."
		/>
		<style>
			section { margin-top: 4.5rem; }
			.hero {
				display: grid;
				grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
				gap: 2.5rem;
				align-items: center;
				padding-top: 1.5rem;
			}
			.hero p { color: var(--muted); font-size: 1.15rem; }
			.stage {
				display: grid;
				place-items: center;
				min-height: 340px;
				border: 1px solid var(--border);
				background:
					radial-gradient(circle at 50% 35%, rgba(46, 118, 248, 0.25), transparent 60%),
					linear-gradient(180deg, var(--midnight), var(--carbon));
			}
			.row { display: flex; flex-wrap: wrap; gap: 0.75rem; }
			h2 { font-size: 2.1rem; margin-bottom: 0.4rem; }
			h2 + .spectrum-bar { margin-bottom: 1.5rem; }
			.lead { color: var(--muted); max-width: 720px; }
			.num { font-family: var(--font-mono); color: var(--volt); font-size: 0.8rem; letter-spacing: 0.16em; }

			/* pillars */
			.pillars { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
			.pillar { padding: 0; overflow: hidden; }
			.pillar img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 0; display: block; }
			.pillar div { padding: 1.1rem 1.25rem 1.3rem; }
			.pillar h3 { font-size: 1.25rem; margin: 0.2rem 0; }
			.pillar p { margin: 0; color: var(--muted); font-size: 0.95rem; }
			.pillar u { text-decoration-color: var(--volt); text-decoration-thickness: 2px; }

			/* logo */
			.logos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
			.tile {
				display: grid;
				place-items: center;
				gap: 0.75rem;
				min-height: 220px;
				padding: 1.5rem;
				border: 1px solid var(--border);
				background: var(--surface);
				position: relative;
			}
			.tile.light { background: #eef2f8; }
			.tile .cap {
				position: absolute;
				left: 0.9rem;
				top: 0.7rem;
				font-family: var(--font-mono);
				font-size: 0.7rem;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--faint);
			}
			.tile.light .cap { color: #5b6476; }
			.sizes { display: flex; gap: 1.5rem; align-items: end; }
			.sizes span { display: block; text-align: center; font-family: var(--font-mono); font-size: 0.7rem; color: var(--faint); margin-top: 0.4rem; }
			.clear { outline: 1px dashed rgba(155, 235, 42, 0.6); outline-offset: 18px; }
			.rules { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
			.rules ul { margin: 0; padding-left: 1.2rem; color: var(--muted); }
			.rules li { margin-bottom: 0.35rem; }
			.do h3 { color: var(--volt); }
			.dont h3 { color: var(--danger); }

			/* colour */
			.core { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
			.swatch { border: 1px solid var(--border); background: var(--surface); }
			.chip-big {
				height: 150px;
				display: flex;
				align-items: end;
				padding: 1rem;
				font-family: var(--font-display);
				font-weight: 700;
				font-size: 1.35rem;
			}
			.meta { padding: 0.9rem 1rem 1.1rem; font-size: 0.92rem; color: var(--muted); }
			.meta code { font-size: 0.8rem; }
			.meta b { color: var(--fg); }
			.neutrals { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.75rem; margin-top: 1rem; }
			.n { border: 1px solid var(--border); }
			.n i { display: block; height: 64px; }
			.n div { padding: 0.6rem 0.75rem; font-size: 0.82rem; color: var(--muted); }
			.n strong { display: block; color: var(--fg); font-size: 0.92rem; }
			.spectrum-demo { height: 70px; background: var(--spectrum); margin-top: 1rem; box-shadow: 0 0 40px rgba(46, 118, 248, 0.35); }
			.ratio { display: flex; height: 26px; margin-top: 1rem; border: 1px solid var(--border); }
			.ratio span { display: grid; place-items: center; font-family: var(--font-mono); font-size: 0.72rem; }

			/* type */
			.type-row {
				display: grid;
				grid-template-columns: 220px minmax(0, 1fr);
				gap: 1.5rem;
				padding: 1.4rem 0;
				border-bottom: 1px solid var(--border);
				align-items: center;
			}
			.type-row .face { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; }
			.type-row .face small { display: block; font-family: var(--font-sans); font-weight: 400; color: var(--muted); font-size: 0.85rem; }
			.type-row .sample { font-size: 1.9rem; line-height: 1.2; }
			.type-row .w { display: block; font-family: var(--font-mono); font-size: 0.75rem; color: var(--faint); margin-top: 0.35rem; }

			/* ui */
			.ui { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
			.ui .card h3 { font-size: 1.1rem; }

			/* voice */
			.voice { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
			.voice .card h3 { font-size: 1.15rem; margin-bottom: 0.25rem; }
			.voice .card p { margin: 0; color: var(--muted); font-size: 0.93rem; }
			.say { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
			.say blockquote { margin: 0; }

			@media (max-width: 860px) {
				.hero, .pillars, .logos, .rules, .core, .ui, .say { grid-template-columns: minmax(0, 1fr); }
				.neutrals, .voice { grid-template-columns: repeat(2, minmax(0, 1fr)); }
				.type-row { grid-template-columns: minmax(0, 1fr); gap: 0.4rem; }
				.type-row .sample { font-size: 1.45rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<!-- 00 · intro -->
			<div class="hero">
				<div>
					<span class="eyebrow">// Brand guidelines · v2.0 "Neon Shield"</span>
					<h1>One shield. <span class="gradient-text">One spectrum.</span> One Republic.</h1>
					<p>
						Everything you need to use the <strong>Custom PC Republic</strong> brand: the logo, colours, type,
						UI parts and voice. <u>When in doubt, copy this page.</u>
					</p>
					<div class="row">
						<a class="btn btn-primary" href="/brand/cpr-mark.svg" download>Download mark (SVG)</a>
						<a class="btn" href="/brand/cpr-favicon.svg" download>Small mark (SVG)</a>
						<a class="btn" href="/images/og-default.jpg" download>Social card (JPG)</a>
					</div>
				</div>
				<div class="stage"><Wordmark layout="stacked" size={170} tagline /></div>
			</div>

			<!-- 01 · idea -->
			<section>
				<span class="num">01 · THE IDEA</span>
				<h2>Three ingredients</h2>
				<span class="spectrum-bar"></span>
				<p class="lead">The system takes the strongest part of each original artwork and keeps <strong>only that</strong>.</p>
				<div class="pillars">
					<div class="card pillar">
						<img src="/brand/moodboard/shield.jpg" alt="Steel shield with glowing circuit traces" loading="lazy" />
						<div>
							<span class="num">THE SHIELD</span>
							<h3>🛡️ Play secure</h3>
							<p>The <u>steel shield and circuit nodes</u> become the mark. It stands for security, which is what sets us apart.</p>
						</div>
					</div>
					<div class="card pillar">
						<img src="/brand/moodboard/neon-case.jpg" alt="Neon green, blue and violet custom PC case" loading="lazy" />
						<div>
							<span class="num">THE SPECTRUM</span>
							<h3>⚡ Plug in</h3>
							<p>The <u>volt → blue → violet</u> neon and the carbon weave carry the energy of gaming builds.</p>
						</div>
					</div>
					<div class="card pillar">
						<img src="/brand/moodboard/joburg-night.jpg" alt="Blue-lit PC in front of the Johannesburg skyline at night" loading="lazy" />
						<div>
							<span class="num">THE SKYLINE</span>
							<h3>🌃 Made in Jo'burg</h3>
							<p>The <u>wide geometric wordmark</u>, midnight navy and the Hillbrow Tower skyline say where we're from.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- 02 · logo -->
			<section>
				<span class="num">02 · LOGO</span>
				<h2>The mark &amp; lockups</h2>
				<span class="spectrum-bar"></span>
				<p class="lead">
					The nodes always run <strong style="color:var(--volt)">volt on the left</strong>,
					<strong style="color:var(--blue)">blue down the spine</strong> and
					<strong style="color:var(--primary)">violet on the right</strong>, in the same order as the spectrum.
				</p>
				<div class="logos">
					<div class="tile"><span class="cap">Primary · horizontal</span><Wordmark size={84} /></div>
					<div class="tile"><span class="cap">Stacked + tagline</span><Wordmark layout="stacked" size={96} tagline /></div>
					<div class="tile">
						<span class="cap">Mark sizes</span>
						<div class="sizes">
							<div><Logo size={96} variant="full" /><span>full ≥ 56px</span></div>
							<div><Logo size={48} variant="simple" /><span>simple</span></div>
							<div><Logo size={32} variant="simple" /><span>32</span></div>
							<div><Logo size={16} variant="simple" /><span>16</span></div>
						</div>
					</div>
					<div class="tile light"><span class="cap">On light</span><Logo size={110} variant="full" /></div>
				</div>
				<div class="rules">
					<div class="card do">
						<h3>✅ Do</h3>
						<ul>
							<li>Leave <strong>clear space of ¼ the mark's height</strong> on every side.</li>
							<li>Use the <strong>full shield at 56px and up</strong>, and the simple 3-node shield below that.</li>
							<li>Put the logo on <strong>Carbon, Midnight</strong> or a dark photo with a scrim.</li>
							<li>Write "CUSTOM PC" in steel and "REPUBLIC" in the spectrum.</li>
						</ul>
					</div>
					<div class="card dont">
						<h3>🚫 Don't</h3>
						<ul>
							<li>Recolour or reorder the nodes.</li>
							<li>Stretch, rotate or outline the shield.</li>
							<li>Put the spectrum on <strong>body text</strong>. It's only for the wordmark, bars and accents.</li>
							<li>Place the logo on busy neon photos without a dark backing.</li>
						</ul>
					</div>
				</div>
			</section>

			<!-- 03 · colour -->
			<section>
				<span class="num">03 · COLOUR</span>
				<h2>Palette</h2>
				<span class="spectrum-bar"></span>
				<p class="lead">
					Use the <strong>60 / 30 / 10</strong> rule: mostly dark ground, some steel and text, and
					<u>just a little neon</u>. Neon works because it's rare.
				</p>
				<div class="core">
					{
						core.map((c) => (
							<div class="swatch">
								<div class="chip-big" style={`background:${c.hex};color:${c.ink}`}>{c.name}</div>
								<div class="meta">
									<b>{c.hex}</b> · rgb({c.rgb}) · <code>{c.token}</code>
									<br />{c.role}
									<br /><small>Contrast on Carbon: {c.aa}</small>
								</div>
							</div>
						))
					}
				</div>
				<div class="spectrum-demo" role="img" aria-label="Spectrum gradient: volt green to circuit blue to shield violet"></div>
				<p class="lead" style="margin-top:.6rem"><code>--spectrum</code>: linear-gradient(90deg, #9BEB2A, #2E76F8 50%, #7B3CF4)</p>
				<div class="neutrals">
					{
						neutrals.map((n) => (
							<div class="n">
								<i style={`background:${n.hex}`} />
								<div><strong>{n.name}</strong>{n.hex} · <code>{n.token}</code><br />{n.role}</div>
							</div>
						))
					}
				</div>
				<div class="neutrals" style="grid-template-columns:repeat(2,minmax(0,1fr))">
					{
						tints.map((t) => (
							<div class="n">
								<i style={`background:${t.hex}`} />
								<div><strong>{t.name}</strong>{t.hex} · <code>{t.token}</code> · {t.aa} on Carbon</div>
							</div>
						))
					}
				</div>
				<div class="ratio" aria-label="60 30 10 colour ratio">
					<span style="flex:60;background:#04070f;color:#a3aec2">60% CARBON / MIDNIGHT</span>
					<span style="flex:30;background:#c5cad3;color:#04070f">30% STEEL</span>
					<span style="flex:10;background:var(--spectrum);color:#04070f">10%</span>
				</div>
			</section>

			<!-- 04 · type -->
			<section>
				<span class="num">04 · TYPOGRAPHY</span>
				<h2>Typefaces</h2>
				<span class="spectrum-bar"></span>
				<p class="lead">Four Google Fonts, <strong>each with one job</strong>.</p>
				{
					type.map((t) => (
						<div class="type-row">
							<div class="face">{t.face}<small>{t.role}</small></div>
							<div>
								<div class:list={['sample', t.cls]} style={`font-family:${t.css}`}>{t.sample}</div>
								<span class="w">{t.weights} · {t.css}</span>
							</div>
						</div>
					))
				}
			</section>

			<!-- 05 · ui -->
			<section>
				<span class="num">05 · INTERFACE</span>
				<h2>UI building blocks</h2>
				<span class="spectrum-bar"></span>
				<p class="lead">Corners are <strong>machined, not pill-shaped</strong>. Buttons use a 10px chamfer, like the octagonal case panels.</p>
				<div class="ui">
					<div class="card">
						<h3>Buttons</h3>
						<div class="row">
							<a class="btn btn-primary" href="#">Primary · Volt</a>
							<a class="btn" href="#">Secondary</a>
						</div>
						<p style="color:var(--muted);margin:.8rem 0 0;font-size:.92rem">Use <strong>one volt button per view</strong>. It's the main action.</p>
					</div>
					<div class="card">
						<h3>Labels &amp; rules</h3>
						<span class="eyebrow">// Eyebrow label</span>
						<span class="spectrum-bar" style="margin:.4rem 0 1rem"></span>
						<span class="pill">#tag</span> <span class="pill">#zero-trust</span>
					</div>
				</div>
			</section>

			<!-- 06 · voice -->
			<section>
				<span class="num">06 · VOICE</span>
				<h2>How we sound</h2>
				<span class="spectrum-bar"></span>
				<p class="lead">Tagline: <strong class="gradient-text" style="font-size:1.2em">Plug in. Play secure.</strong></p>
				<div class="voice">
					<div class="card"><h3>⚙️ Technical</h3><p>Real specs, real numbers. Skip the hype.</p></div>
					<div class="card"><h3>🤝 Friendly</h3><p>Explain it like you would at the bench.</p></div>
					<div class="card"><h3>🛡️ Secure</h3><p>Security is part of every build, not an add-on.</p></div>
					<div class="card"><h3>📍 Local</h3><p>Proudly Westdene, Randburg, Jo'burg.</p></div>
				</div>
				<div class="say">
					<blockquote>✅ "Pulse 1440: high-refresh 1440p, wired for a segmented home network."</blockquote>
					<blockquote style="border-left-color:var(--danger)">🚫 "The ULTIMATE INSANE gaming beast!!!"</blockquote>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
