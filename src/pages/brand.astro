---
import Page from '../layouts/Page.astro';
import Logo from '../components/Logo.astro';
import Wordmark from '../components/Wordmark.astro';
import { BRAND } from '../consts';

const core = [
	{ name: 'Republic Violet', hex: '#7C6CFF', role: 'Primary buttons, active states, the chip die.', ink: '#FFFFFF' },
	{ name: 'Edge Blue', hex: '#3BA6FF', role: 'Links, labels, prices, circuit nodes.', ink: '#07060E' },
	{ name: 'Brushed Steel', hex: '#C9CCD6', role: 'Shield rim, chip frame, icons.', ink: '#07060E' },
];
const themes = [
	{
		name: 'Dark',
		rows: [
			['Background', '#07060E', '--bg'],
			['Panel', '#14111F', '--panel'],
			['Border', '#2A2640', '--border'],
			['Heading text', '#ECEAF6', '--fg'],
			['Reading text', '#D9D6E8', '--text'],
			['Muted', '#A4A0B8', '--muted'],
			['Violet (text)', '#8F82FF', '--primary'],
			['Blue (text)', '#5CB4FF', '--blue'],
		],
	},
	{
		name: 'Light',
		rows: [
			['Background', '#F7F6FB', '--bg'],
			['Panel', '#FFFFFF', '--panel'],
			['Border', '#E1DEEE', '--border'],
			['Heading text', '#16131F', '--fg'],
			['Reading text', '#2E2A3D', '--text'],
			['Muted', '#5C5772', '--muted'],
			['Violet (text)', '#5A48E0', '--primary'],
			['Blue (text)', '#1A62B0', '--blue'],
		],
	},
];
const type = [
	{ face: 'Syne', role: 'Headings & the name', weights: '600–800', sample: 'Plug in. Play secure.', css: 'var(--font-display)', size: '2rem' },
	{ face: 'Outfit', role: 'Body & UI', weights: '400 · 600 emphasis · 18px base, 1.7–1.8 line height', sample: 'Hand-built systems, Zero Trust staging and serverless delivery from Westdene, Randburg.', css: 'var(--font-sans)', size: '1.25rem' },
	{ face: 'IBM Plex Mono', role: 'Labels, hosts, prices, code', weights: '400–500 · uppercase labels +16% tracking', sample: 'SHOP.CUSTOMPCREPUBLIC.COM · R 28 990', css: 'var(--font-mono)', size: '1.05rem' },
];
---

<Page
	title="Brand guidelines"
	description="Custom PC Republic brand system: logo, colour (light & dark), type, UI and voice."
	eyebrow="Brand guidelines · v3"
	heading="One shield, two themes, one Republic."
	lead="The blog now matches custompcrepublic.com: deep ink, violet and blue, Syne and Outfit — calmer neon, easier reading, and a light mode."
>
	<div slot="intro" class="row">
		<a class="btn btn-primary" href="/brand/cpr-mark.svg" download>Download mark (SVG)</a>
		<a class="btn" href="/brand/cpr-favicon.svg" download>Small mark (SVG)</a>
		<a class="btn" href="/images/og-default.jpg" download>Social card (JPG)</a>
	</div>

	<!-- 01 logo -->
	<section>
		<span class="num">01 · LOGO</span>
		<h2>The shield chip</h2>
		<p class="lead">
			A <strong>steel shield</strong> (security) around a <strong>CPU chip</strong> (hardware), with circuit traces
			reaching out to <strong class="v">violet</strong> and <strong class="b">blue</strong> nodes. It combines the shield
			artwork, the business-card chip and the main site's violet/blue palette.
		</p>
		<div class="logos">
			<div class="tile dark"><span class="cap">On dark</span><Logo size={150} variant="full" /></div>
			<div class="tile light"><span class="cap">On light</span><Logo size={150} variant="full" /></div>
			<div class="tile"><span class="cap">Lockup</span><Wordmark size={64} /></div>
			<div class="tile">
				<span class="cap">Sizes</span>
				<div class="sizes">
					<div><Logo size={84} variant="full" /><span>full ≥ 56px</span></div>
					<div><Logo size={40} variant="simple" /><span>simple</span></div>
					<div><Logo size={24} variant="simple" /><span>24</span></div>
					<div><Logo size={16} variant="simple" /><span>16</span></div>
				</div>
			</div>
		</div>
		<div class="rules">
			<div class="card"><h3 class="ok">✅ Do</h3><ul>
				<li>Keep <strong>clear space of ¼ the mark's height</strong> around it.</li>
				<li>Use the <strong>full mark at 56px and up</strong>, and the simple 4-node mark for favicons and small UI.</li>
				<li>Put the name in <strong>Syne Bold</strong> with "IT SYNERGY ENERGY" in Plex Mono below it.</li>
			</ul></div>
			<div class="card"><h3 class="no">🚫 Don't</h3><ul>
				<li>Recolour the nodes or add new colours (no green, orange or cyan).</li>
				<li>Stretch, rotate, outline or add heavy neon glow.</li>
				<li>Use the old "Custom PC RSA" script logo, which is retired.</li>
			</ul></div>
		</div>
	</section>

	<!-- 02 colour -->
	<section>
		<span class="num">02 · COLOUR</span>
		<h2>Palette</h2>
		<p class="lead">
			<strong>Two accents, used sparingly.</strong> Most of every page is background and text. Long-form text uses the
			softer <code>--text</code> tone, so reading is comfortable in both themes.
		</p>
		<div class="core">
			{
				core.map((c) => (
					<div class="swatch">
						<div class="chip" style={`background:${c.hex};color:${c.ink}`}>{c.name}</div>
						<div class="meta"><b>{c.hex}</b><br />{c.role}</div>
					</div>
				))
			}
		</div>
		<div class="themes">
			{
				themes.map((t) => (
					<div class="card theme">
						<h3>{t.name} theme</h3>
						<ul>
							{t.rows.map(([n, hex, tok]) => (
								<li><i style={`background:${hex}`} /><span>{n}</span><code>{hex}</code><small>{tok}</small></li>
							))}
						</ul>
					</div>
				))
			}
		</div>
		<p class="small">All text colours meet WCAG AA (4.5 : 1) against their background in both themes.</p>
	</section>

	<!-- 03 type -->
	<section>
		<span class="num">03 · TYPOGRAPHY</span>
		<h2>Typefaces</h2>
		<p class="lead">The same three Google Fonts as the main site.</p>
		{
			type.map((t) => (
				<div class="type-row">
					<div class="face">{t.face}<small>{t.role}</small></div>
					<div>
						<div class="sample" style={`font-family:${t.css};font-size:${t.size}`}>{t.sample}</div>
						<span class="w">{t.weights}</span>
					</div>
				</div>
			))
		}
	</section>

	<!-- 04 ui -->
	<section>
		<span class="num">04 · INTERFACE</span>
		<h2>UI &amp; readability</h2>
		<div class="ui">
			<div class="card">
				<h3>Buttons &amp; chips</h3>
				<div class="row">
					<a class="btn btn-primary" href="#">Primary</a>
					<a class="btn" href="#">Secondary</a>
					<span class="pill">#tag</span>
				</div>
				<p class="small">Rounded 12px buttons, 18px cards, pill chips. Use <strong>one primary button per view</strong>.</p>
			</div>
			<div class="card">
				<h3>Reading rules</h3>
				<ul>
					<li><strong>18px</strong> body, <strong>1.8</strong> line height in posts</li>
					<li>Posts max <strong>70 characters</strong> wide</li>
					<li>Gradient text <strong>only</strong> in the hero line</li>
					<li>Light / dark toggle in every header</li>
				</ul>
			</div>
		</div>
	</section>

	<!-- 05 imagery -->
	<section>
		<span class="num">05 · IMAGERY</span>
		<h2>Source artwork</h2>
		<p class="lead">The references this system was built from. They're for <strong>mood</strong>, not for reuse as logos.</p>
		<div class="mood">
			<figure><img src="/brand/moodboard/business-card.jpg" alt="Custom PC RSA business card with shield and chip" loading="lazy" /><figcaption>Business card: shield + chip, violet/blue, Simplify · Integrate · Automate</figcaption></figure>
			<figure><img src="/brand/moodboard/shield.jpg" alt="Steel circuit shield" loading="lazy" /><figcaption>Steel shield and circuit traces</figcaption></figure>
			<figure><img src="/brand/moodboard/joburg-night.jpg" alt="PC in front of the Johannesburg skyline" loading="lazy" /><figcaption>Jo'burg skyline: where we're from</figcaption></figure>
			<figure><img src="/brand/moodboard/neon-case.jpg" alt="Neon custom case" loading="lazy" /><figcaption>Neon case: energy, used sparingly</figcaption></figure>
		</div>
	</section>

	<!-- 06 voice -->
	<section>
		<span class="num">06 · VOICE</span>
		<h2>How we sound</h2>
		<p class="lead">Tagline: <strong>{BRAND.tagline}</strong> · Promise: {BRAND.pitch}</p>
		<div class="voice">
			<div class="card"><h3>⚙️ Technical</h3><p>Real specs, rand prices, measured frames.</p></div>
			<div class="card"><h3>🤝 Plain</h3><p>We take the tech jargon out of your tech.</p></div>
			<div class="card"><h3>🛡️ Secure</h3><p>Security is part of every build, not an add-on.</p></div>
			<div class="card"><h3>📍 Local</h3><p>Westdene, Randburg, Jo'burg.</p></div>
		</div>
	</section>
</Page>

<style>
	section { margin-top: 4rem; }
	h2 { font-size: 2rem; }
	.row { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
	.num { font-family: var(--font-mono); color: var(--blue); font-size: 0.78rem; letter-spacing: 0.16em; }
	.v { color: var(--primary); }
	.b { color: var(--blue); }
	.small { color: var(--muted); font-size: 0.92rem; margin-top: 0.8rem; }
	.logos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
	.tile {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 220px;
		padding: 1.5rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
	}
	.tile.dark { background: #07060e; }
	.tile.light { background: #f7f6fb; }
	.cap {
		position: absolute;
		left: 0.9rem;
		top: 0.7rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #8a85a0;
	}
	.sizes { display: flex; gap: 1.5rem; align-items: end; }
	.sizes span { display: block; text-align: center; font-family: var(--font-mono); font-size: 0.7rem; color: var(--faint); margin-top: 0.4rem; }
	.rules, .ui { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
	.rules ul, .ui ul { margin: 0; padding-left: 1.2rem; color: var(--muted); }
	.rules li, .ui li { margin-bottom: 0.35rem; }
	.ok { color: var(--ok); font-size: 1.2rem; }
	.no { color: var(--danger); font-size: 1.2rem; }
	.core { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
	.swatch { border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--panel); }
	.chip { height: 120px; display: flex; align-items: end; padding: 1rem; font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; }
	.meta { padding: 0.85rem 1rem 1rem; color: var(--muted); font-size: 0.92rem; }
	.meta b { color: var(--fg); font-family: var(--font-mono); }
	.themes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
	.theme h3 { font-size: 1.2rem; }
	.theme ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.45rem; }
	.theme li { display: grid; grid-template-columns: 26px 1fr auto auto; gap: 0.6rem; align-items: center; font-size: 0.92rem; }
	.theme i { width: 26px; height: 26px; border-radius: 6px; border: 1px solid var(--border); }
	.theme small { color: var(--faint); font-family: var(--font-mono); font-size: 0.75rem; }
	.type-row { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 1.5rem; padding: 1.3rem 0; border-bottom: 1px solid var(--border); align-items: center; }
	.face { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; }
	.face small { display: block; font-family: var(--font-sans); font-weight: 400; color: var(--muted); font-size: 0.85rem; }
	.sample { line-height: 1.3; }
	.w { display: block; font-family: var(--font-mono); font-size: 0.75rem; color: var(--faint); margin-top: 0.35rem; }
	.ui h3 { font-size: 1.15rem; }
	.mood { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
	.mood figure { margin: 0; }
	.mood img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
	.mood figcaption { font-size: 0.85rem; color: var(--muted); margin-top: 0.4rem; }
	.voice { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
	.voice h3 { font-size: 1.1rem; }
	.voice p { margin: 0; color: var(--muted); font-size: 0.93rem; }
	@media (max-width: 860px) {
		.logos, .rules, .ui, .core, .themes { grid-template-columns: minmax(0, 1fr); }
		.mood, .voice { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.type-row { grid-template-columns: minmax(0, 1fr); gap: 0.4rem; }
		.theme li { grid-template-columns: 26px 1fr auto; }
		.theme small { display: none; }
	}
</style>
