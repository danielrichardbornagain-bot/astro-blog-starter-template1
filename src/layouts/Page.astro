---
// Shared shell for simple content pages.
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	eyebrow?: string;
	heading: string;
	lead?: string;
}
const { title, description, eyebrow, heading, lead } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} · Custom PC Republic`} description={description} />
		<slot name="head" />
	</head>
	<body>
		<Header />
		<main>
			<section class="page-intro">
				{eyebrow && <span class="eyebrow">{eyebrow}</span>}
				<h1>{heading}</h1>
				{lead && <p class="lead">{lead}</p>}
				<slot name="intro" />
			</section>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-intro {
		padding: 1rem 0 1.5rem;
		max-width: 780px;
	}
	.page-intro h1 {
		font-size: clamp(2.2rem, 5vw, 3.2rem);
	}
</style>
